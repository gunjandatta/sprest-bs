{
    "compilerOptions": {
        "esModuleInterop": false,
        "ignoreDeprecations": "6.0",
        "lib": [
            "dom",
            "es2015"
        ],
        "moduleResolution": "node",
        "outDir": "./build",
        "rootDir": "./src",
        "skipLibCheck": true,
        "strict": false,
        "target": "es2015"
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src/**/*.ts"
    ]
}